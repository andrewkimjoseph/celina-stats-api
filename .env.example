# Copy to `.dev.vars` for `npm run dev`. Set the same names as Worker secrets
# with `npx wrangler secret put` (account_id in wrangler.jsonc pins CELINA).

# Supabase (service role — Worker only, never expose to browsers)
# SUPABASE_URL=https://jlrvsxrtnvwywblweuhe.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Celo mainnet RPC (default: https://forno.celo.org)
# CELO_RPC_URL=https://forno.celo.org

# Amplitude. AMPLITUDE_API_KEY forwards POST /telemetry and authenticates the
# midnight export. AMPLITUDE_SECRET_KEY is export-only.
# AMPLITUDE_API_KEY=
# AMPLITUDE_SECRET_KEY=
# AMPLITUDE_REGION=us

# Bearer token for GET /onchain, GET /offchain/*, and GET /package.
# Same value as STATS_READ_KEY on celina-website. Reads fail closed when unset.
# STATS_READ_KEY=
