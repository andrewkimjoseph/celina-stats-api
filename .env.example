# Copy to `.dev.vars` for `npm run dev`. Set the same names as Worker secrets
# in the Cloudflare dashboard (do not use local wrangler CLI to deploy).

# Supabase (service role — Worker only, never expose to browsers)
# SUPABASE_URL=https://jlrvsxrtnvwywblweuhe.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Celo mainnet RPC (default: https://forno.celo.org)
# CELO_RPC_URL=https://forno.celo.org

# Amplitude Export API — midnight UTC cron sync into amplitude_events
# AMPLITUDE_API_KEY=
# AMPLITUDE_SECRET_KEY=
# AMPLITUDE_REGION=us
